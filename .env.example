# Copy this file to .env and replace the secret before first startup.
# Generate a secret with:
#   powershell -ExecutionPolicy Bypass -File .\scripts\New-SecretKey.ps1
SECRET_KEY_BASE=replace-with-a-random-secret
OPENPROJECT_HOST_NAME=localhost:8080
OPENPROJECT_HTTPS=false
OPENPROJECT_DEFAULT_LANGUAGE=ja
PORT=8080

